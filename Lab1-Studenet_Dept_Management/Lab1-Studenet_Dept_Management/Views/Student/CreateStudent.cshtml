
@{
    ViewBag.Title = "CreateStudent";
}

<h2>Add a New Student</h2>

<form method="post">
    <label class="col-form-label-sm" for="Name" name="Name">Name:</label>
    <input class="form-control form-text" id="Name" name="Name" type="text" required />

    <label class="col-form-label-sm" for="Cgpa" name="Cgpa">Cgpa:</label>
    <input class="form-control form-text" id="Cgpa" name="Cgpa" type="number" step="0.01" min="0" max="4" required />

    <label class="col-form-label-sm" for="Deperment" name="Deperment">Deperment:</label>

    <select class="form-control form-select" id="D_Id" name="D_Id">
        <option value="" selected disabled>Select a Department</option>
        @{
            foreach (var d in Model)
            {
                <option value="@d.Id">@d.Title</option>
            }
        }
    </select>
    <br />
    <br />
    <button class="btn btn-primary" type="submit">Add</button>
    <a class="btn btn-secondary" href="/Department/Index">Cancel</a>



</form>

