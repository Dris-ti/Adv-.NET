
@{
    ViewBag.Title = "Edit";
    var dept = ViewBag["dept"].ToList();
}

<h2>Edit</h2>

@{ 
    bool checkDept(int dId)
    {
        if (Model.Department_ID.Equals(dId))
        {
            return true;
        }
        return false;
    }
}


<form method="post">
    <input class="form-control" name="Id" id="Id" type="hidden" />

    <label for="Name" id="Name">Name</label>
    <input class="form-control" name="Name" id="Name" type="text" value="@Model.Name"/>
    <br />

    <label for="Cgpa" id="Cgpa">Cgpa</label>
    <input class="form-control" name="Cgpa" id="Cgpa" type="number" step="0.1" min="0.0" max="4.00" value="@Model.Cgpa" />
    <br />

    <select name="Department">
        <option disabled selected>Select Department</option>
        @{
            foreach (var d in dept)
            {
                <option selected="@checkDept(d.Id)" value="@d.Id">@d.Title</option>
            }
        }
    </select>

    <br />

    <input class="btn btn-primary" type="submit" value="Add" />

</form>